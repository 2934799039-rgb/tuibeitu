generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  TRIALING
}

enum SchoolType {
  BAZI
  ZIWEI
  LIUYAO
  MEIHUA_YISHU
  QIMEN_DUNJIA
  ZHOUYI
  TAROT
  NAME_NUMEROLOGY
  PHONE_NUMEROLOGY
  DAILY_FORTUNE
  YEARLY_ANALYSIS
  ROMANCE
  WEALTH
  CAREER
}

enum ReadingStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String         @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             UserRole       @default(USER)
  freeReadingsUsed Int            @default(0)
  chatCredits      Int            @default(10)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  accounts     Account[]
  sessions     Session[]
  readings     UserReading[]
  subscription Subscription?

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserReading {
  id         String        @id @default(cuid())
  userId     String?
  schoolType SchoolType
  inputData  Json
  status     ReadingStatus @default(PROCESSING)
  locale     String        @default("en")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  result ReadingResult?

  @@index([userId, createdAt(sort: Desc)])
  @@index([schoolType])
  @@map("user_readings")
}

model ReadingResult {
  id                 String   @id @default(cuid())
  readingId          String   @unique
  calculationResult  Json
  aiAnalysis         Json
  recommendations    Json
  chartData          Json?
  aiModel            String?
  aiTokensUsed       Int?
  generationTimeMs   Int?
  createdAt          DateTime @default(now())

  reading UserReading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@map("reading_results")
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  plan                   SubscriptionPlan   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}
